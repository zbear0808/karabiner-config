                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "⏪ (back track) key should only control Apple Music.",
                        "manipulators": [
                            {
                                "from": { "key_code": "f7" },
                                "to_if_alone": [{ "shell_command": "osascript -e 'tell application \"Music\" to back track'" }],
                                "to_if_held_down": [{ "shell_command": "osascript -e 'tell application \"Music\" to rewind'" }],
                                "type": "basic"
                            }
                        ]
