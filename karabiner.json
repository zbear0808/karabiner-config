{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "double left shift to cap_lock",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "name": "left_shift pressed",
                                        "type": "variable_if",
                                        "value": 1
                                    }
                                ],
                                "from": {
                                    "key_code": "left_shift",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "caps_lock" }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "left_shift",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "set_variable": {
                                            "name": "left_shift pressed",
                                            "value": 1
                                        }
                                    },
                                    { "key_code": "left_shift" }
                                ],
                                "to_delayed_action": {
                                    "to_if_canceled": [
                                        {
                                            "set_variable": {
                                                "name": "left_shift pressed",
                                                "value": 0
                                            }
                                        }
                                    ],
                                    "to_if_invoked": [
                                        {
                                            "set_variable": {
                                                "name": "left_shift pressed",
                                                "value": 0
                                            }
                                        }
                                    ]
                                },
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "⏩ (next track) key should only control Apple Music.",
                        "manipulators": [
                            {
                                "from": { "key_code": "f9" },
                                "to_if_alone": [{ "shell_command": "osascript -e 'tell application \"Music\" to next track'" }],
                                "to_if_held_down": [{ "shell_command": "osascript -e 'tell application \"Music\" to fast forward'" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "⏯ (play/pause) key should only control Apple Music.",
                        "manipulators": [
                            {
                                "from": { "key_code": "f8" },
